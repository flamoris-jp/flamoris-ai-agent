# ============================================================================
# Copy this file to ".env" and fill in deployment-specific values.
# Do not commit .env.
# ============================================================================

# PostgreSQL connection to the database initialized with db/01_schema.sql.
# Supply the host/port, database, application role, and that role's password from
# your PostgreSQL administrator. These are connection settings, not Agent identity.
# Keep PGPASSWORD private; changing the database changes the stored identities.
PGHOST=your-postgresql-host
PGPORT=5432
PGDATABASE=flamoris_ai
PGUSER=flamoris_ai_app
PGPASSWORD=your-password

# Stable database keys for this single-principal deployment. Choose private,
# deployment-specific values once. Setup rejects an existing key whose stored
# identity metadata differs; changing a key creates a different identity.
# The human key identifies the configured human; the display name is a label,
# but setup currently requires it to match the existing row for that key.
FLAMORIS_HUMAN_KEY=example-user
FLAMORIS_HUMAN_DISPLAY_NAME=Example User
# Agent key selects both the DB identity and agents/<agent-key>/agent.toml.
# It must contain only letters, digits, underscores, or hyphens.
# Display name and type are DB metadata; setup requires matching existing values.
FLAMORIS_AGENT_KEY=example-agent
FLAMORIS_AGENT_DISPLAY_NAME=Example Agent
# Optional type defaults to "agent"; keep it stable for an existing Agent key.
# FLAMORIS_AGENT_TYPE=agent
# Project key identifies the Agent's project; name/slug are metadata, but setup
# requires them to match the existing project row. Slug must be unique for a root.
FLAMORIS_PROJECT_KEY=example.project
FLAMORIS_PROJECT_NAME=Example Project
FLAMORIS_PROJECT_SLUG=example-project
# Host key is a stable application-defined DB key, not necessarily the OS hostname.
# Registration records the actual OS hostname and rejects reuse of the key on a
# different hostname. Containers may report a different hostname than the host.
FLAMORIS_HOST_KEY=example-host
# Application key is a stable DB key; name is checked metadata for that key.
FLAMORIS_APPLICATION_KEY=flamoris-ai-agent
FLAMORIS_APPLICATION_NAME=FLAMORIS AI Agent
# Stable DB model key. This is NOT the provider's served model ID. Registration
# currently records provider=llama.cpp and the resolved served ID under this key;
# it rejects a reused key pointing to a different served ID.
FLAMORIS_MODEL_KEY=example-provider:example-model

# Optional label on each runtime instance row (default: console). It is metadata,
# not an identity key; changing it does not repoint host/application/model keys.
FLAMORIS_INSTANCE_LABEL=example-instance

# URL reachable by this process for GET /v1/models and POST /v1/chat/completions.
# The current adapter records provider=llama.cpp; compatibility with other
# providers is not a claim of provider-neutral registration in this phase.
INTELLIGENCE_BASE_URL=http://127.0.0.1:8081
# Optional only when /v1/models exposes exactly one model. With multiple models,
# set the exact data[].id; a configured ID absent from the list fails startup.
# INTELLIGENCE_MODEL=

# PostgreSQL stores all messages. Positive window sizes are clamped to 1..64.
# Current conversation messages included in a request (default 16).
AGENT_CONTEXT_MESSAGES=16
# Previous conversation messages retrieved for reference (default 12).
AGENT_PREVIOUS_MESSAGES=12
# Whether console startup includes the latest scoped prior conversation as
# untrusted reference data; false disables it (default true).
AGENT_LOAD_PREVIOUS_CONVERSATION=true

# Optional absolute deployment directory. Export before starting the process;
# it must exist and is authoritative for .env and agents/<agent-key>/agent.toml.
# No fallback to a bundled Agent when the selected context is missing.
# FLAMORIS_AGENT_HOME=/absolute/path/to/deployment

# HTTP transport only: required private 32..512 ASCII non-whitespace token.
# AGENT_MCP_TOKEN=
# HTTP bind host and port (defaults below); Compose sets host=0.0.0.0 internally.
# AGENT_HTTP_HOST=127.0.0.1
# AGENT_HTTP_PORT=8768
# Comma-separated exact Host header values allowed by the private HTTP service.
# AGENT_HTTP_ALLOWED_HOSTS=localhost:8768,127.0.0.1:8768,[::1]:8768
# Explicit shared HTTP catalog only, AFTER migration and exact delegation grants.
# Trusted server caller identity; never a browser/user-supplied principal claim.
# Review docs/PRINCIPAL_SESSIONS.md and Hub catalog parity before enabling.
# AGENT_HTTP_DELEGATOR_KEY=studio_backend

# Explicit approved Intelligence MCP adapter (default remains direct).
# Read docs/INTELLIGENCE_MCP.md, verify downstream locality and DB model mapping.
# No automatic direct/remote fallback if this configuration or dispatch fails.
# AGENT_INTELLIGENCE_TRANSPORT=mcp
# AGENT_INTELLIGENCE_MCP_ENDPOINT=http://127.0.0.1:8767/mcp
# AGENT_INTELLIGENCE_TARGET={"public_model_id":"gpt-oss-20b","provider_id":"llamacpp","db_model_name":"served-alias","db_provider":"llama.cpp","data_flow":"local_only"}
