# ============================================================================
# Copy this file to ".env" and fill in the PostgreSQL connection values.
# Do not commit .env.
# ============================================================================

# PostgreSQL / Decopon
PGHOST=your-postgresql-host
PGPORT=5432
PGDATABASE=flamoris_ai
PGUSER=flamoris_ai_app
PGPASSWORD=your-password

# Stable identities registered by db/02_seed_umeko.sql
FLAMORIS_HUMAN_KEY=akino
FLAMORIS_AGENT_KEY=umeko
FLAMORIS_PROJECT_KEY=flamoris.ai.umeko
FLAMORIS_HOST_KEY=lime
FLAMORIS_APPLICATION_KEY=umeko-chat
FLAMORIS_MODEL_KEY=llama.cpp:gpt-oss-20b

# Label for this concrete execution instance.
FLAMORIS_INSTANCE_LABEL=lime-console

# OpenAI-compatible llama.cpp endpoint (local to LIME).
INTELLIGENCE_BASE_URL=http://127.0.0.1:8081
# Optional when /v1/models exposes exactly one model. Otherwise set its exact id.
# INTELLIGENCE_MODEL=

# PostgreSQL stores all messages.
# The model receives only the most recent N messages plus system context.
UMEKO_CONTEXT_MESSAGES=16
