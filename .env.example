# ============================================================================
# C:\FLAMORIS\flamoris_ai\.env
# Copy this file to ".env" and fill in PGPASSWORD.
# Do not commit .env.
# ============================================================================

# PostgreSQL / Decopon
PGHOST=decopon.flamoris.net
PGPORT=5432
PGDATABASE=flamoris_ai
PGUSER=flamoris_ai_app
PGPASSWORD=ここにflamoris_ai_appのパスワード

# Stable identities registered by db/02_seed_umeko.sql
FLAMORIS_HUMAN_KEY=akino
FLAMORIS_AGENT_KEY=umeko
FLAMORIS_PROJECT_KEY=flamoris.ai.umeko
FLAMORIS_HOST_KEY=mango
FLAMORIS_APPLICATION_KEY=umeko-chat
FLAMORIS_MODEL_KEY=ollama:umeko

# Label for this concrete execution instance.
FLAMORIS_INSTANCE_LABEL=mango-console

# Ollama
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=umeko

# PostgreSQL stores all messages.
# Ollama receives only the most recent N messages plus system context.
UMEKO_CONTEXT_MESSAGES=16
